# Copy to .env and set your own password.
POSTGRES_USER=zabanbuzz
POSTGRES_PASSWORD=change-me
POSTGRES_DB=zabanbuzz
POSTGRES_PORT=5432
APP_PORT=3000

# Used by Prisma and `npm run dev` on the host. Inside Docker, compose overrides it to point at the db service.
DATABASE_URL=postgresql://zabanbuzz:change-me@localhost:5432/zabanbuzz

# Sign-in with a one-time code. Keep off until an SMS and email provider are connected.
AUTH_OTP_ENABLED=false
